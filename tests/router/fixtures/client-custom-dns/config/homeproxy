config homeproxy 'config'
	option routing_mode 'custom'
	option proxy_mode 'redirect_tproxy'
	option ipv6_support '0'
	option log_level 'warn'

config homeproxy 'routing'
	option default_outbound 'direct-out'
	option default_outbound_dns 'default-dns'

config homeproxy 'dns'
	option default_server 'default-dns'

config dns_server 'legacy_server'
	option label 'legacy-server'
	option enabled '1'
	option type 'udp'
	option server '1.1.1.1'

config dns_rule 'legacy_ip_rule'
	option label 'legacy-ip-rule'
	option enabled '1'
	option action 'route'
	option server 'legacy_server'
	list ip_cidr '1.0.0.0/8'
	option ip_is_private '1'

config dns_rule 'modern_rule'
	option label 'modern-rule'
	option enabled '1'
	option action 'evaluate'
	option server 'legacy_server'
	option evaluate_tag 'first'

config dns_rule 'modern_response'
	option label 'modern-response'
	option enabled '1'
	option action 'route'
	option server 'legacy_server'
	option match_response 'first'
	option response_rcode 'NOERROR'
	list response_answer 'example.com. 300 IN A 1.2.3.4'
	option race '1'

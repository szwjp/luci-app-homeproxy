config homeproxy 'infra'
	option tun_name 'singtun0'
	option tun_addr4 '172.19.0.1/30'
	option tun_addr6 'fdfe:dcba:9876::1/126'
	option tun_mtu '9000'

config homeproxy 'config'
	option routing_mode 'custom'
	option proxy_mode 'tun'
	option ipv6_support '0'
	option log_level 'warn'
	option tun_dns_mode 'hijack'
	list tun_dns_address '172.19.0.1'
	option udp_mapping 'endpoint_independent'
	option udp_filtering 'address_dependent'
	option udp_nat_max '8192'

config homeproxy 'routing'
	option default_outbound 'direct-out'
	option default_outbound_dns 'default-dns'
	option find_neighbor '1'

config homeproxy 'dns'
	option default_server 'default-dns'

config routing_rule 'mac_rule'
	option label 'mac-rule'
	option enabled '1'
	option action 'route'
	option outbound 'direct-out'
	list source_mac_address '00:11:22:33:44:55'
	list source_hostname 'nas'

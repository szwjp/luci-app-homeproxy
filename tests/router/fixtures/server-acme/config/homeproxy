config homeproxy 'server'
	option enabled '1'
	option log_level 'warn'

config server 'acme_trojan'
	option label 'acme-trojan'
	option enabled '1'
	option type 'trojan'
	option port '8443'
	option password 'secret'
	option tls '1'
	option tls_acme '1'
	option tls_acme_email 'admin@example.com'
	list tls_acme_domain 'example.com'
	option tls_acme_provider 'letsencrypt'
	option tls_acme_key_type 'p256'
	option tls_acme_profile 'shortlived'
	option tls_acme_account_key '-----BEGIN PRIVATE KEY-----'
